#####
### Begin my System.prop
#####
ro.secure=1
# GSI always disables adb authentication
ro.adb.secure=0
ro.debuggable=1
persist.sys.usb.config=adb,vser,gser
persist.service.adb.enable=1
persist.sys.timezone = Europe/Moscow
persist.service.adb.enable=1
persist.service.debuggable=1
persist.sys.root_access=1
ro.zygote=zygote32
ro.treble.enabled=true
ro.build.system_root_image=true
ro.config.low_ram=true
# GSI always generate dex pre-opt in system image
ro.cp_system_other_odex=0
# TODO(b/78105955): disable privapp_permissions checking before the bug solved
ro.control_privapp_permissions=disable
#####
### Crypt
#####
ro.vendor.keybox.id.value=SPRD
ro.vendor.product.partitionpath=/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/
# Oreo:
ro.keybox.id.value=SPRD
ro.product.partitionpath=/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/
#
ro.hardware.keystore=sprdtrusty
sys.usb.controller=musb-hdrc.0.auto
ro.boot.avb_version=1.0
ro.boot.vbmeta.avb_version=1.0
#ro.crypto.volume.filenames_mode=aes-256-cts
#ro.crypto.metadata.enabled=true
#ro.crypto.support_metadata_encrypt=true
#ro.crypto.uses_fs_ioc_add_encryption_key=true
ro.crypto.fs_crypto_blkdev=/dev/block/dm-0
ro.crypto.fuse_sdcard=true
#ro.crypto.volume.metadata.method=dm-default-key
#ro.crypto.dm_default_key.options_format.version=2
#ro.crypto.volume.options=::v2
#####
### Enable sdcardfs feature and Storage
#####
ro.sys.sdcardfs=true
persist.sys.sdcardfs=force_on
ro.frp.pst=/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/persist
ro.storage.flash_type=2
sys.internal.emulated=1
persist.storage.type=2
ro.storage.install2internal=0
drm.service.enabled=true
ro.se.copy_map_src=mnt/sdcard/0/Sygic
ro.se.copy_map_aim=mnt/extsd/Sygic
#####
